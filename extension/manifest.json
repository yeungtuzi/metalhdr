{
  "manifest_version": 3,
  "name": "MetalHDR",
  "version": "0.1.0",
  "description": "SDR 视频实时转 HDR：自动读取屏幕亮度上限，软肩滚降不裁切。",
  "key": "",
  "minimum_chrome_version": "129",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "MetalHDR",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "content_scripts": [{
    "matches": ["*://*/*"],
    "js": ["shared/core.js", "src/shaders.js", "src/renderers.js", "src/site.js", "src/content.js"],
    "css": ["src/content.css"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
